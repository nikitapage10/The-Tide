{
  "name": "the-tide",
  "version": "0.1.0",
  "private": true,
  "description": "The Tide \u2014 private worldbuilding and tabletop campaign dashboard for Ilyr.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "demo": "cross-env TIDE_DATA_MODE=demo next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "contract:schema": "tsx scripts/generate-json-schema.ts",
    "contract:hash": "tsx scripts/hash-bundle.ts",
    "demo:reset": "node scripts/reset-demo.mjs",
    "publish:bundle": "NODE_OPTIONS=--conditions=react-server tsx scripts/publish-bundle.ts",
    "publish:lore": "tsx scripts/build-lore-bundle.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/publish-bundle.ts fixtures/publication/lore-release.json"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
