# The Tide — environment template. PLACEHOLDERS ONLY. Copy to .env.local and fill in.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser;
# everything else is SERVER-ONLY.

# ----------------------------------------------------------------- mode (server-only)
# "demo"     = local seeded demo with file persistence (never on Vercel / production)
# "supabase" = connected mode
# unset      = setup-required screen (fail closed)
TIDE_DATA_MODE=demo

# Optional, demo only: where the local demo JSON file lives (default .tide-demo/state.json)
# TIDE_DEMO_STATE_FILE=.tide-demo/state.json
# Optional, demo only: allow `next start` (production build) to run demo mode locally for testing.
# TIDE_ALLOW_DEMO_IN_PRODUCTION_BUILD=false

# ----------------------------------------------------------------- Supabase (PUBLIC)
# Safe to expose: the URL and publishable (anon) key. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Older projects may use the legacy anon key name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------- server-only
# UUID of your private project row (see docs/SUPABASE_SETUP.md).
TIDE_PROJECT_ID=00000000-0000-4000-8000-000000000000

# Only needed for the future machine publisher. NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# (legacy name also accepted) SUPABASE_SERVICE_ROLE_KEY=

# Machine publisher: hex SHA-256 of a long random bearer token. Store only the hash here.
# Leave unset to disable machine publishing entirely.
# TIDE_PUBLISHER_TOKEN_SHA256=

# Extra origins allowed to send cookie-authenticated mutations (comma-separated). Usually unset.
# TIDE_ALLOWED_ORIGINS=
